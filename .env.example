# ============================================
# KIBAT INVEST — Les clés de la plateforme
# Copie ce fichier en ".env" et remplis les valeurs
# ============================================

# 🔐 Sécurité (OBLIGATOIRE)
JWT_SECRET=change-moi-par-une-longue-phrase-secrete
DATABASE_URL=postgresql://utilisateur:motdepasse@adresse:5432/kibat

# 🌐 Le serveur
PORT=3000

# 💳 Paiements — Orange Money (orange.com/orangemoneydeveloperapi)
ORANGE_MONEY_API_KEY=
ORANGE_MONEY_URL=
KIBAT_RETURN_URL=
KIBAT_CANCEL_URL=
KIBAT_NOTIF_URL=

# 🌊 Paiements — Wave (wave.com → Developers)
WAVE_API_KEY=

# 📱 Paiements — MTN MoMo (momodeveloper.mtn.com)
MTN_MOMO_API_KEY=
MTN_MOMO_URL=
MTN_ENV=sandbox
MTN_CURRENCY=XOF
PAYER_PHONE=

# 🔵 Paiements — Moov Money
MOOV_API_KEY=
MOOV_URL=

# 💳 Paiements — Carte bancaire (stripe.com)
STRIPE_SECRET_KEY=

# 🤖 Kelas l'IA (platform.openai.com)
OPENAI_API_KEY=
