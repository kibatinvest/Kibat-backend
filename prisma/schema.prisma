// Kibat Invest — structure de la base de données

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(uuid())
  phone           String    @unique
  role            String    @default("USER")
  walletBalance   Decimal   @default(0) @db.Decimal(14, 2)
  isPro           Boolean   @default(false)
  proExpiresAt    DateTime?
  kelasMessages   Int       @default(0)
  kelasResetAt    DateTime?
  createdAt       DateTime  @default(now())

  investments     Investment[]
  payouts         Payout[]
  subscriptions   Subscription[]
  managedProjects Project[] @relation("Manager")
  transactions    Transaction[]
}

model OtpCode {
  id        String   @id @default(uuid())
  phone     String
  code      String
  createdAt DateTime @default(now())
}

model Project {
  id               String    @id @default(uuid())
  name             String
  sector           String
  emoji            String    @default("🌱")
  place            String
  description      String
  goal             Int
  collected        Int       @default(0)
  profitShare      Int
  status           String    @default("COLLECTING")
  risks            String[]
  managerId        String
  manager          User      @relation("Manager", fields: [managerId], references: [id])
  commissionRate   Float     @default(0.0175)
  commissionAmount Int       @default(0)
  collectEndsAt    DateTime?
  createdAt        DateTime  @default(now())

  milestones  Milestone[]
  videos      VideoReport[]
  investments Investment[]

  @@index([status, createdAt])
}

model Milestone {
  id          String    @id @default(uuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id])
  index       Int
  label       String
  amount      Int
  status      String    @default("PENDING")
  proofUrl    String?
  auditedBy   String?
  validatedAt DateTime?
}

model VideoReport {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  videoUrl  String
  dayCode   String
  createdAt DateTime @default(now())
}

model Investment {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  amount    Int
  txRef     String   @unique
  status    String   @default("ESCROWED")
  createdAt DateTime @default(now())
}

model Payout {
  id        String   @id @default(uuid())
  projectId String?
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  amount    Int
  createdAt DateTime @default(now())
}

model Subscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  amount    Decimal  @db.Decimal(14, 2)
  type      String
  month     String
  txRef     String   @unique
  createdAt DateTime @default(now())
}

model Transaction {
  id        String   @id @default(uuid())
  reference String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  amount    Int
  provider  String
  type      String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
}
